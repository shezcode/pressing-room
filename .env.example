# Settings for docker-compose.prod.yml. Copy to .env and fill in; never commit .env.

# Image to run: ghcr.io/<owner>/<repo>, lowercased. CI pushes `latest` and the commit SHA;
# scripts/deploy.sh rewrites this line with the tag it deploys.
IMAGE=ghcr.io/shezcode/pressing-room:latest

# Nginx Proxy Manager's Docker network (find it with `docker network ls`). The app joins it.
PROXY_NETWORK=npm_default

# Port the server listens on inside the container. Point the proxy host at this port.
PORT=3000

# Required. Signs the session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Required in production. The seeded Admin account, created at start if missing.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true runs the public Demo: all data is reset to the seed on every start, and the app shows a banner.
DEMO_MODE=true

# Required when DEMO_MODE=true. The Demo Customer, re-created with two past Orders on every start.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=

# Origins allowed to call the API cross-origin. The app itself is same-origin and needs none of this.
ALLOWED_ORIGINS=https://pressingroom.shezcode.com
