{
  "name": "pressing-room",
  "version": "20.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start_docker": "ng serve --disable-host-check --host 0.0.0.0 --port 4200 --poll 200 ",
    "build": "ng build",
    "build_dev": "npm run build -- --configuration=dev",
    "build_pre": "npm run build -- --configuration=pre",
    "build_production": "npm run build -- --configuration=production",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "ng test",
    "test:ci": "ng test --watch=false --code-coverage",
    "check:deps-age": "node scripts/check-age.js",
    "preinstall": "npm run check:deps-age",
    "extract:translations": "ngx-translate-extract --input ./src --output ./src/assets/i18n/es.json ./src/assets/i18n/en.json --sort --format namespaced-json",
    "release:first": "standard-version --no-verify --first-release",
    "release:patch": "standard-version --no-verify --release-as patch",
    "release:minor": "standard-version --no-verify --release-as minor",
    "release:major": "standard-version --no-verify --release-as major",
    "bundle:report": "source-map-explorer --no-border-checks dist/pressing-room/browser/**/*.js",
    "e2e": "node e2e/run.mjs",
    "capture:readme": "node e2e/capture.mjs"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run check:deps-age && npm run lint && npm run test:ci",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~20.3.17",
    "@angular/cdk": "~20.2.14",
    "@angular/common": "~20.3.17",
    "@angular/compiler": "~20.3.17",
    "@angular/core": "~20.3.17",
    "@angular/forms": "~20.3.17",
    "@angular/material": "~20.2.14",
    "@angular/platform-browser": "~20.3.17",
    "@angular/platform-browser-dynamic": "~20.3.17",
    "@angular/router": "~20.3.17",
    "@ngx-translate/core": "~15.0.0",
    "@ngx-translate/http-loader": "~8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "~2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~20.3.18",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "~20.3.18",
    "@angular/compiler-cli": "~20.3.17",
    "@bartholomej/ngx-translate-extract": "~8.0.2",
    "@biesbjerg/ngx-translate-extract-marker": "^1.0.0",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@playwright/test": "~1.64.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "~20.14.9",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^4.3.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^2.8.8",
    "source-map-explorer": "^2.5.0",
    "standard-version": "~9.5.0",
    "typescript": "~5.8.2"
  }
}
